		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Wstęp bazy wiedzy"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja","layout":{"type":"constrained","contentSize":"760px"}} -->
<div class="wp-block-group alignfull gdp-sekcja">
<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Wiedza</h1>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Artykuły o zmianie sprzedawcy gazu, umowach i wypowiedzeniach, cenach i rynku, biometanie i raportowaniu oraz sprzedaży rezerwowej. Pięć artykułów roboczych i pełny hub kategorii: [[P1.2]].</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
]]></content:encoded>
