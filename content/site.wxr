		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Nagłówek"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-section gdp-prawne-naglowek","layout":{"type":"constrained","contentSize":"760px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-section gdp-prawne-naglowek">
<!-- wp:paragraph {"className":"gdp-etykieta","fontSize":"xs"} -->
<p class="gdp-etykieta has-xs-font-size"><a href="/">Start</a> · <a href="/dokumenty/">Dokumenty</a></p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Polityka prywatności</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">Dokument opisuje, jak PBM Sp. z o.o. przetwarza dane osobowe osób korzystających ze strony i formularzy. Treść dostarczy zleceniodawca; poniżej struktura sekcji.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-meta","fontSize":"xs"} -->
<p class="gdp-meta has-xs-font-size">Ostatnia aktualizacja: [[data]]. Wersja: [[nr wersji]].</p>
