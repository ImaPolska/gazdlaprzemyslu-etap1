<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Biometan z aktywów Grupy, certyfikacja, Scope 1 i CSRD bez obietnic.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta gdp-card gdp-kategoria"} -->
