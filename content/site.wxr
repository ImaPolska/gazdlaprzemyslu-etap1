<!-- wp:group {"metadata":{"name":"§ 1"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-sekcja--zwarta gdp-prawne","layout":{"type":"constrained","contentSize":"760px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-sekcja--zwarta gdp-prawne">
<!-- wp:heading -->
