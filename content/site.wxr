	<item>
		<title><![CDATA[Slot: tabela cen]]></title>
		<link>https://playground.wordpress.net/?p=9003</link>
		<pubDate>Sun, 13 Sep 2026 10:00:00 +0000</pubDate>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<guid isPermaLink="false">https://playground.wordpress.net/?p=9003</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Slot: tabela cen"},"templateLock":"contentOnly","className":"gdp-slot gdp-slot--m5 gdp-price-table","layout":{"type":"constrained","contentSize":"1200px"}} -->
<div class="wp-block-group gdp-slot gdp-slot--m5 gdp-price-table">
<!-- wp:paragraph {"fontSize":"xs","className":"gdp-meta","metadata":{"name":"Data aktualizacji","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-meta has-xs-font-size">Data aktualizacji pasm: [[data]]</p>
<!-- /wp:paragraph -->

<!-- wp:table {"hasFixedLayout":false} -->
<figure class="wp-block-table"><table><thead><tr><th>Segment odbiorcy</th><th>Zużycie roczne</th><th>Pasmo ceny za paliwo gazowe [[jednostka]]</th><th>Model umowy</th></tr></thead><tbody><tr><td>Małe i średnie firmy</td><td>do [[X]] GWh</td><td>[[od]] – [[do]]</td><td>Umowa kompleksowa, cena stała</td></tr><tr><td>Przemysł</td><td>[[X]] – [[Y]] GWh</td><td>[[od]] – [[do]]</td><td>Cena stała lub indeksowana TGE</td></tr><tr><td>Duży przemysł</td><td>powyżej [[Y]] GWh</td><td>oferta indywidualna</td><td>Model transzowy</td></tr></tbody></table></figure>
<!-- /wp:table -->

<!-- wp:paragraph {"fontSize":"xs"} -->
<p class="has-xs-font-size">Pasma dotyczą wyłącznie ceny paliwa gazowego. Dystrybucja, akcyza i opłaty regulowane są doliczane według taryfy Twojego operatora.</p>
<!-- /wp:paragraph -->

<!-- wp:block {"ref":9009} /-->
</div>
<!-- /wp:group -->
]]></content:encoded>
		<excerpt:encoded><![CDATA[]]></excerpt:encoded>
