	<item>
		<title><![CDATA[Kontakt]]></title>
		<link>https://playground.wordpress.net/?p=120</link>
		<pubDate>Sun, 13 Sep 2026 10:00:00 +0000</pubDate>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<guid isPermaLink="false">https://playground.wordpress.net/?p=120</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Hero: kontakt"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-hero","layout":{"type":"constrained","contentSize":"1200px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-hero">
<!-- wp:paragraph {"className":"gdp-etykieta","fontSize":"xs"} -->
<p class="gdp-etykieta has-xs-font-size"><a href="/">Start</a> · Kontakt</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Kontakt z PBM</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">Najszybsza droga do oferty to przesłanie faktury. Jeśli chcesz porozmawiać o modelu transzowym, wielu punktach poboru albo współpracy partnerskiej, użyj formularza lub zadzwoń w godzinach pracy.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/wgraj-fakture/">Wgraj fakturę</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
</div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Dane i formularz"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-section gdp-formularz-sekcja","layout":{"type":"constrained","contentSize":"1200px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-section gdp-formularz-sekcja">
<!-- wp:columns -->
<div class="wp-block-columns">
<!-- wp:column -->
<div class="wp-block-column">
<!-- wp:heading -->
<h2 class="wp-block-heading">Dane kontaktowe</h2>
<!-- /wp:heading -->
<!-- wp:table {"hasFixedLayout":false,"className":"gdp-tabela gdp-kontakt-dane"} -->
<figure class="wp-block-table gdp-tabela gdp-kontakt-dane"><table><thead><tr><th></th><th></th></tr></thead><tbody><tr><td>Telefon</td><td>[[numer telefonu]]</td></tr><tr><td>E-mail</td><td>[[adres e-mail ofertowy]]</td></tr><tr><td>Adres</td><td>PBM Sp. z o.o., [[ulica i numer]], [[kod pocztowy i miasto]]</td></tr><tr><td>Godziny</td><td>dni robocze [[godziny, np. 8:00–16:00]]</td></tr><tr><td>Dane rejestrowe</td><td>[[KRS, NIP, REGON]]</td></tr><tr><td>Opiekun doradców</td><td>[[imię i nazwisko, telefon, e-mail]]</td></tr></tbody></table></figure>
<!-- /wp:table -->
<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Mapa</h3>
<!-- /wp:heading -->
<!-- wp:paragraph {"className":"gdp-mapa gdp-placeholder"} -->
<p class="gdp-mapa gdp-placeholder">[[mapa dojazdu — bez osadzeń zewnętrznych; obraz statyczny lub opis dojazdu dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column">
<!-- wp:group {"metadata":{"name":"Slot: formularz kontaktowy"},"templateLock":"contentOnly","className":"gdp-formularz gdp-form-card gdp-slot gdp-slot--kontakt","layout":{"type":"constrained","contentSize":"560px","justifyContent":"left"}} -->
<div class="wp-block-group gdp-formularz gdp-form-card gdp-slot gdp-slot--kontakt">
<!-- wp:heading {"level":3,"fontSize":"l"} -->
<h3 class="wp-block-heading has-l-font-size">Napisz do nas</h3>
<!-- /wp:heading -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">Imię i nazwisko</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">Firma i NIP</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">E-mail służbowy</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">Telefon (opcjonalnie)</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">Temat: oferta / model transzowy / współpraca / inne</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">Wiadomość</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/kontakt/">Wyślij wiadomość</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->

<!-- wp:paragraph {"className":"gdp-meta","fontSize":"xs"} -->
<p class="gdp-meta has-xs-font-size">Wysyłając formularz, wyrażasz zgodę na przetwarzanie danych w celu przygotowania oferty: [[treść zgody dostarczy zleceniodawca]]. Polityka prywatności: [[link]].</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
</div>
<!-- /wp:column -->
</div>
<!-- /wp:columns -->
</div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Godziny i czas odpowiedzi"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-section gdp-sekcja--surface gdp-surface","layout":{"type":"constrained","contentSize":"760px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-section gdp-sekcja--surface gdp-surface">
<!-- wp:heading -->
<h2 class="wp-block-heading">Kiedy odpowiadamy</h2>
<!-- /wp:heading -->

<!-- wp:table {"hasFixedLayout":false,"className":"gdp-tabela"} -->
<figure class="wp-block-table gdp-tabela"><table><thead><tr><th>Sprawa</th><th>Czas odpowiedzi</th></tr></thead><tbody><tr><td>Oferta po przesłaniu faktury</td><td>24 godziny w dni robocze</td></tr><tr><td>Analiza umowy</td><td>24 godziny w dni robocze; przy wielu aneksach do 2 dni</td></tr><tr><td>Model transzowy, wiele punktów poboru</td><td>kontakt opiekuna w ciągu [[termin]] dni roboczych</td></tr><tr><td>Współpraca partnerska</td><td>kontakt opiekuna kanału w ciągu [[termin]] dni roboczych</td></tr><tr><td>Reklamacje</td><td>zgodnie z procedurą reklamacyjną: [[termin]] dni</td></tr></tbody></table></figure>
<!-- /wp:table -->
</div>
<!-- /wp:group -->
]]></content:encoded>
