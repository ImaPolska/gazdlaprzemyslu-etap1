	<item>
		<title><![CDATA[Slot: upload faktury]]></title>
		<link>https://playground.wordpress.net/?p=9002</link>
		<pubDate>Sun, 13 Sep 2026 10:00:00 +0000</pubDate>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<guid isPermaLink="false">https://playground.wordpress.net/?p=9002</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Slot: upload faktury"},"templateLock":"contentOnly","className":"gdp-formularz gdp-hero-form gdp-slot gdp-slot--m1","layout":{"type":"constrained","contentSize":"480px","justifyContent":"left"}} -->
<div class="wp-block-group gdp-formularz gdp-hero-form gdp-slot gdp-slot--m1">
<!-- wp:heading {"level":2,"fontSize":"l"} -->
<h2 class="wp-block-heading has-l-font-size">Oferta z Twojej faktury w 24 godziny</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"xs"} -->
<p class="has-xs-font-size">Wystarczy jedna faktura za gaz. Odczytamy z niej taryfę, zużycie i operatora.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-pole--plik gdp-field gdp-field--file"} -->
<p class="gdp-pole gdp-pole--plik gdp-field gdp-field--file">Faktura za gaz (PDF, JPG lub PNG). Przeciągnij plik tutaj albo wybierz z dysku.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">E-mail służbowy</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">Telefon</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">NIP firmy</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button {"width":100} -->
<div class="wp-block-button has-custom-width wp-block-button__width-100"><a class="wp-block-button__link wp-element-button" href="/kontakt/">Wyślij fakturę i odbierz ofertę</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->

<!-- wp:paragraph {"fontSize":"xs","className":"gdp-mikrodowod"} -->
<p class="gdp-mikrodowod has-xs-font-size">Odpowiadamy w 24 godziny w dni robocze. Fakturę usuwamy po przygotowaniu oferty, jeśli nie podpiszesz umowy: [[okres retencji]].</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"fontSize":"xs","className":"gdp-prawne"} -->
<p class="gdp-prawne has-xs-font-size">[[treść zgody dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
]]></content:encoded>
		<excerpt:encoded><![CDATA[]]></excerpt:encoded>
