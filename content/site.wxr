	<item>
		<title><![CDATA[Wzorzec: segmenty]]></title>
		<link>https://playground.wordpress.net/?p=9007</link>
		<pubDate>Sun, 13 Sep 2026 10:00:00 +0000</pubDate>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<guid isPermaLink="false">https://playground.wordpress.net/?p=9007</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Wzorzec: segmenty"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-segmenty gdp-segments","layout":{"type":"constrained","contentSize":"1200px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-segmenty gdp-segments">
<!-- wp:heading {"metadata":{"name":"Nagłówek segmentów","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<h2 class="wp-block-heading">Wybierz swoją sytuację</h2>
<!-- /wp:heading -->

<!-- wp:columns -->
<div class="wp-block-columns">
<!-- wp:column {"className":"gdp-karta gdp-card"} -->
<div class="wp-block-column gdp-karta gdp-card">
<!-- wp:heading {"level":3,"metadata":{"name":"Segment 1: tytuł","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<h3 class="wp-block-heading">Zużycie do [[X]] GWh rocznie</h3>
<!-- /wp:heading -->
<!-- wp:paragraph {"metadata":{"name":"Segment 1: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p>Jedna umowa na sprzedaż i dystrybucję, cena stała na cały okres. Ofertę przygotujemy z Twojej faktury w 24 godziny.</p>
<!-- /wp:paragraph -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/wgraj-fakture/">Wgraj fakturę</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
</div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta gdp-card"} -->
<div class="wp-block-column gdp-karta gdp-card">
<!-- wp:heading {"level":3,"metadata":{"name":"Segment 2: tytuł","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<h3 class="wp-block-heading">Zużycie powyżej [[X]] GWh rocznie</h3>
<!-- /wp:heading -->
<!-- wp:paragraph {"metadata":{"name":"Segment 2: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p>Cena stała, indeksowana do TGE lub zakupy w transzach. Opiekun przygotuje ofertę dopasowaną do profilu Twoich punktów poboru.</p>
<!-- /wp:paragraph -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button {"className":"is-style-outline"} -->
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="/dla-kogo/przemysl/">Porozmawiaj z opiekunem</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
</div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta gdp-card"} -->
<div class="wp-block-column gdp-karta gdp-card">
<!-- wp:heading {"level":3,"metadata":{"name":"Segment 3: tytuł","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<h3 class="wp-block-heading">Jesteś doradcą energetycznym</h3>
<!-- /wp:heading -->
<!-- wp:paragraph {"metadata":{"name":"Segment 3: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p>Model współpracy dla doradców i agencji obsługujących firmy: [[model współpracy]]. Zgłoś się, oddzwonimy.</p>
<!-- /wp:paragraph -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button {"className":"is-style-outline"} -->
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="/dla-doradcow/">Zgłoś się</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
</div>
<!-- /wp:column -->
</div>
<!-- /wp:columns -->
</div>
<!-- /wp:group -->
]]></content:encoded>
