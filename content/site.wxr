<!-- wp:group {"metadata":{"name":"§ 8"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-sekcja--zwarta gdp-prawne","layout":{"type":"constrained","contentSize":"760px"}} -->
