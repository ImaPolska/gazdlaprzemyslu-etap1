<!-- /wp:paragraph -->

<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Regulamin serwisu</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">Regulamin określa zasady korzystania ze strony gazdlaprzemyslu i narzędzi udostępnianych na niej przez PBM Sp. z o.o. Treść dostarczy zleceniodawca; poniżej struktura sekcji.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-meta","fontSize":"xs"} -->
<p class="gdp-meta has-xs-font-size">Ostatnia aktualizacja: [[data]]. Wersja: [[nr wersji]].</p>
