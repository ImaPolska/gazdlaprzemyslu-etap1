<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>[[treść dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"§ 3"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-sekcja--zwarta gdp-prawne","layout":{"type":"constrained","contentSize":"760px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-sekcja--zwarta gdp-prawne">
<!-- wp:heading -->
<h2 class="wp-block-heading">3. Cele i podstawy prawne przetwarzania</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>[[treść dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->

