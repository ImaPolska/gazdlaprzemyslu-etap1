	</item>
	<item>
		<title><![CDATA[Wiedza]]></title>
		<link>https://playground.wordpress.net/?p=104</link>
		<pubDate>Sun, 13 Sep 2026 10:00:00 +0000</pubDate>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<guid isPermaLink="false">https://playground.wordpress.net/?p=104</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Hero: wiedza"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-hero","layout":{"type":"constrained","contentSize":"760px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-hero">
<!-- wp:paragraph {"className":"gdp-etykieta","fontSize":"xs"} -->
<p class="gdp-etykieta has-xs-font-size"><a href="/">Start</a> · Wiedza</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Wiedza o zakupie gazu dla firm</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">Artykuły o zmianie sprzedawcy, umowach i wypowiedzeniach, cenach i rynku, biometanie i sprzedaży rezerwowej. Każdy tekst zaczyna się od odpowiedzi w kilku zdaniach, ma spis treści, źródła, datę i autora.</p>
<!-- /wp:paragraph -->

<!-- wp:search {"label":"Szukaj w bazie wiedzy","showLabel":false,"placeholder":"np. okres wypowiedzenia","buttonText":"Szukaj","className":"gdp-szukaj"} /-->
</div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Kategorie"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-section gdp-kategorie gdp-sekcja--surface gdp-surface","layout":{"type":"constrained","contentSize":"1200px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-section gdp-kategorie gdp-sekcja--surface gdp-surface">
<!-- wp:heading -->
<h2 class="wp-block-heading">Kategorie</h2>
<!-- /wp:heading -->

<!-- wp:columns -->
<div class="wp-block-columns">
<!-- wp:column {"className":"gdp-karta gdp-card gdp-kategoria"} -->
<div class="wp-block-column gdp-karta gdp-card gdp-kategoria">
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading"><a href="/wiedza/kategoria/zmiana-sprzedawcy/">Zmiana sprzedawcy</a></h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Kolejność kroków, terminy, pełnomocnictwo, zgłoszenie do operatora.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta gdp-card gdp-kategoria"} -->
<div class="wp-block-column gdp-karta gdp-card gdp-kategoria">
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading"><a href="/wiedza/kategoria/umowy-i-wypowiedzenia/">Umowy i wypowiedzenia</a></h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Okres wypowiedzenia, klauzula prolongacyjna, art. 4j Prawa energetycznego.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta gdp-card gdp-kategoria"} -->
<div class="wp-block-column gdp-karta gdp-card gdp-kategoria">
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading"><a href="/wiedza/kategoria/ceny-i-rynek/">Ceny i rynek</a></h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Cena stała, indeks TGE, transze; z czego składa się cena na fakturze.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:column -->
</div>
<!-- /wp:columns -->

<!-- wp:columns -->
<div class="wp-block-columns">
<!-- wp:column {"className":"gdp-karta gdp-card gdp-kategoria"} -->
<div class="wp-block-column gdp-karta gdp-card gdp-kategoria">
<!-- wp:heading {"level":3} -->
