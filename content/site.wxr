	<item>
		<title><![CDATA[Cena stała]]></title>
		<link>https://playground.wordpress.net/?p=302</link>
		<pubDate>Sun, 13 Sep 2026 10:00:00 +0000</pubDate>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<guid isPermaLink="false">https://playground.wordpress.net/?p=302</guid>
		<description></description>
