		<dc:creator><![CDATA[admin]]></dc:creator>
		<guid isPermaLink="false">https://playground.wordpress.net/?p=123</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Nagłówek"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-section","layout":{"type":"constrained","contentSize":"760px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-section">
<!-- wp:paragraph {"className":"gdp-etykieta","fontSize":"xs"} -->
<p class="gdp-etykieta has-xs-font-size"><a href="/">Start</a> · <a href="/wiedza/">Wiedza</a></p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Komentarz rynkowy</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">Co dzieje się z ceną gazu na TGE i co to znaczy dla Twojej umowy. Krótkie wpisy z datą i autorem, bez prognoz i bez rekomendacji zakupowych.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-meta","fontSize":"xs"} -->
<p class="gdp-meta has-xs-font-size">Pełne archiwum kategorii: <a href="/wiedza/kategoria/komentarz-rynkowy/">komentarz rynkowy</a>.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Lista wpisów"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-section gdp-sekcja--surface gdp-surface","layout":{"type":"constrained","contentSize":"1200px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-section gdp-sekcja--surface gdp-surface">
<!-- wp:query {"queryId":7,"query":{"perPage":12,"pages":0,"offset":0,"postType":"post","order":"desc","orderBy":"date","author":"","search":"","exclude":[],"sticky":"exclude","inherit":false,"taxQuery":{"category":[21]}},"className":"gdp-komentarze gdp-komentarze-sekcja"} -->
<div class="wp-block-query gdp-komentarze gdp-komentarze-sekcja">
<!-- wp:post-template {"layout":{"type":"grid","columnCount":3}} -->
<!-- wp:post-title {"isLink":true,"level":3,"fontSize":"m"} /-->

<!-- wp:group {"layout":{"type":"flex","flexWrap":"wrap"},"fontSize":"xs"} -->
<div class="wp-block-group has-xs-font-size">
<!-- wp:post-date /-->
<!-- wp:post-author-name {"prefix":"Autor: "} /-->
</div>
<!-- /wp:group -->

<!-- wp:post-excerpt {"excerptLength":25} /-->
<!-- /wp:post-template -->

<!-- wp:query-no-results -->
<!-- wp:paragraph -->
<p>Pierwszy komentarz rynkowy pojawi się wkrótce.</p>
<!-- /wp:paragraph -->
<!-- /wp:query-no-results -->
</div>
<!-- /wp:query -->
</div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Slot: subskrypcja"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-section gdp-formularz-sekcja","layout":{"type":"constrained","contentSize":"1200px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-section gdp-formularz-sekcja">
<!-- wp:columns -->
<div class="wp-block-columns">
<!-- wp:column -->
<div class="wp-block-column">
<!-- wp:heading -->
<h2 class="wp-block-heading">Komentarz rynkowy na e-mail</h2>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Jedna wiadomość po każdym nowym komentarzu. Bez ofert, bez newslettera. Możesz zrezygnować jednym kliknięciem.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column">
