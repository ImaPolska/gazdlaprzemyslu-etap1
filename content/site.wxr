		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Nagłówek"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-section gdp-prawne-naglowek","layout":{"type":"constrained","contentSize":"760px"}} -->
