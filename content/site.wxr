</div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"§ 2"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-sekcja--zwarta gdp-prawne","layout":{"type":"constrained","contentSize":"760px"}} -->
