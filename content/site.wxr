<!-- wp:heading {"level":2,"fontSize":"l"} -->
<h2 class="wp-block-heading has-l-font-size">Zgłoś się jako doradca</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"xs"} -->
<p class="has-xs-font-size">Opiekun kanału partnerskiego oddzwoni w ciągu [[ ]] dni roboczych i przedstawi model współpracy.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">Imię i nazwisko</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
