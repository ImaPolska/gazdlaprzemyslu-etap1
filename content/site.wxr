	<item>
		<title><![CDATA[CTA: wgraj fakturę]]></title>
		<link>https://playground.wordpress.net/?p=9001</link>
		<pubDate>Sun, 13 Sep 2026 10:00:00 +0000</pubDate>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<guid isPermaLink="false">https://playground.wordpress.net/?p=9001</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"CTA: wgraj fakturę"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-cta gdp-cta-final","layout":{"type":"constrained","contentSize":"760px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-cta gdp-cta-final">
<!-- wp:heading {"textAlign":"center","metadata":{"name":"Nagłówek CTA","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<h2 class="wp-block-heading has-text-align-center">Prześlij ostatnią fakturę za gaz</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"align":"center","metadata":{"name":"Podtytuł CTA","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="has-text-align-center">Odczytamy z niej taryfę, wolumen i termin umowy. Ofertę dostaniesz w 24 godziny w dni robocze, bez zobowiązań.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons {"layout":{"type":"flex","justifyContent":"center"}} -->
<div class="wp-block-buttons">
<!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/wgraj-fakture/">Wgraj fakturę</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
</div>
<!-- /wp:group -->
]]></content:encoded>
