<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">E-mail służbowy</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">Telefon</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-field"} -->
<p class="gdp-pole gdp-field">Liczba klientów biznesowych z umowami na gaz (orientacyjnie)</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button {"width":100} -->
<div class="wp-block-button has-custom-width wp-block-button__width-100"><a class="wp-block-button__link wp-element-button" href="/kontakt/">Zgłoś się</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->

