		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Pasek zaufania"},"templateLock":"contentOnly","align":"full","className":"gdp-sekcja gdp-sekcja--zwarta gdp-zaufanie gdp-trust-bar","layout":{"type":"constrained","contentSize":"1200px"}} -->
<div class="wp-block-group alignfull gdp-sekcja gdp-sekcja--zwarta gdp-zaufanie gdp-trust-bar">
<!-- wp:columns -->
<div class="wp-block-columns">
<!-- wp:column -->
<div class="wp-block-column">
<!-- wp:paragraph {"className":"gdp-wartosc","metadata":{"name":"Zaufanie 1: wartość","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-wartosc">Grupa IMA Polska</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"fontSize":"xs","metadata":{"name":"Zaufanie 1: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="has-xs-font-size">PBM Sp. z o.o. jest spółką Grupy z własnymi aktywami w energetyce.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column">
<!-- wp:paragraph {"className":"gdp-wartosc","metadata":{"name":"Zaufanie 2: wartość","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-wartosc">Koncesja OPG nr [[ ]]</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"fontSize":"xs","metadata":{"name":"Zaufanie 2: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="has-xs-font-size">Koncesja na obrót paliwami gazowymi wydana przez Prezesa URE.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column">
<!-- wp:paragraph {"className":"gdp-wartosc","metadata":{"name":"Zaufanie 3: wartość","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-wartosc">[[ ]] GWh</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"fontSize":"xs","metadata":{"name":"Zaufanie 3: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="has-xs-font-size">Wolumen gazu dostarczony odbiorcom biznesowym w [[rok]].</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column">
<!-- wp:paragraph {"className":"gdp-wartosc","metadata":{"name":"Zaufanie 4: wartość","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-wartosc">[[ ]] aktywa Grupy</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"fontSize":"xs","metadata":{"name":"Zaufanie 4: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="has-xs-font-size">[[opis aktywów: źródła, magazyny, sieć — dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:column -->
</div>
<!-- /wp:columns -->
</div>
<!-- /wp:group -->
]]></content:encoded>
