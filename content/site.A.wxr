	<item>
		<title><![CDATA[Komentarz rynkowy]]></title>
		<link>https://gazdlaprzemyslu.pl/komentarz-rynkowy/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=1018</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Nagłówek strony"},"templateLock":"contentOnly","align":"full","className":"gdp-hero gdp-hero-produkt","style":{"spacing":{"padding":{"top":"var:preset|spacing|60","bottom":"var:preset|spacing|60"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull gdp-hero gdp-hero-produkt has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)"><!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Komentarz rynkowy</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">Krótkie komentarze o tym, co w danym tygodniu zmieniło się na rynku gazu i co to znaczy dla umowy odbiorcy przemysłowego: notowania TGE, decyzje Prezesa URE, zmiany przepisów. Każdy wpis ma datę, autora i datę ostatniej aktualizacji. Nie publikujemy prognoz cen.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Lista wpisów"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:query {"queryId":21,"query":{"perPage":10,"pages":0,"offset":0,"postType":"post","order":"desc","orderBy":"date","author":"","search":"","exclude":[],"sticky":"exclude","inherit":false,"taxQuery":{"category":["__CAT:komentarz-rynkowy__"]}},"align":"wide","className":"gdp-komentarze"} -->
<div class="wp-block-query alignwide gdp-komentarze"><!-- wp:post-template {"layout":{"type":"grid","columnCount":2}} -->
<!-- wp:post-date {"fontSize":"xs"} /-->

<!-- wp:post-title {"level":3,"isLink":true,"fontSize":"m"} /-->

<!-- wp:post-excerpt {"moreText":"Czytaj dalej","excerptLength":24} /-->

<!-- wp:post-author-name {"fontSize":"xs"} /-->
<!-- /wp:post-template --></div>
<!-- /wp:query --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Subskrypcja (slot)"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Otrzymuj komentarz e-mailem</h2>
<!-- /wp:heading -->

<!-- wp:group {"metadata":{"name":"Subskrypcja (slot)"},"className":"gdp-karta","layout":{"type":"constrained"}} -->
<div class="wp-block-group gdp-karta"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Subskrypcja komentarza rynkowego</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Jeden e-mail tygodniowo, bez ofert handlowych. Rezygnacja jednym kliknięciem.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-etykieta-pola"} -->
<p class="gdp-etykieta-pola">E-mail</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole"} -->
<p class="gdp-pole">imie.nazwisko@firma.pl</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/kontakt/">Subskrybuj</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Zgoda: [[treść zgody dostarczy zleceniodawca]] · <a href="/polityka-prywatnosci/">Polityka prywatności</a></p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"CTA końcowe"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|80","bottom":"var:preset|spacing|80"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--80);padding-bottom:var(--wp--preset--spacing--80)"><!-- wp:block {"ref":"__BLOCK:cta-wgraj-fakture__"} /--></div>
<!-- /wp:group -->]]></content:encoded>
