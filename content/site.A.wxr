	<item>
		<title><![CDATA[Slot: upload faktury]]></title>
		<link>https://gazdlaprzemyslu.pl/slot-upload-faktury/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=9003</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Slot: upload faktury"},"className":"gdp-karta gdp-slot","layout":{"type":"constrained"}} -->
<div class="wp-block-group gdp-karta gdp-slot"><!-- wp:heading {"level":2,"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Wgraj fakturę za gaz</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Wystarczy jedna strona z danymi punktu poboru i zużyciem. PDF, JPG albo PNG.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole gdp-pole-plik"} -->
<p class="gdp-pole gdp-pole-plik">Przeciągnij plik tutaj albo wybierz z dysku</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-etykieta-pola"} -->
<p class="gdp-etykieta-pola">E-mail służbowy</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole"} -->
<p class="gdp-pole">imie.nazwisko@twojafirma.pl</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-etykieta-pola"} -->
<p class="gdp-etykieta-pola">Telefon</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole"} -->
<p class="gdp-pole">+48</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-etykieta-pola"} -->
<p class="gdp-etykieta-pola">NIP</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole"} -->
<p class="gdp-pole">10 cyfr</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/kontakt/">Wyślij i odbierz ofertę w 24 h</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Oferta indykatywna w 24 godziny. Bez zobowiązań. Fakturę usuwamy po [[okres retencji]].</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">[[treść zgody dostarczy zleceniodawca]] <a href="/polityka-prywatnosci/">Polityka prywatności</a></p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->]]></content:encoded>
