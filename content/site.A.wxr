	<item>
		<title><![CDATA[Wiedza]]></title>
		<link>https://gazdlaprzemyslu.pl/wiedza/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=1017</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Nagłówek strony"},"templateLock":"contentOnly","align":"full","className":"gdp-hero gdp-hero-produkt","style":{"spacing":{"padding":{"top":"var:preset|spacing|60","bottom":"var:preset|spacing|60"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull gdp-hero gdp-hero-produkt has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)"><!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Baza wiedzy o gazie dla firm</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">Krótkie odpowiedzi na pytania energetyków zakładowych, dyrektorów finansowych i właścicieli firm: jak zmienić sprzedawcę, jak policzyć termin wypowiedzenia, kiedy grozi sprzedaż rezerwowa, który model ceny pasuje do profilu zużycia i co zmienia prawo. Każdy artykuł zaczyna się od odpowiedzi, kończy źródłami.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Wyszukiwanie"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:search {"label":"Szukaj w bazie wiedzy","showLabel":false,"placeholder":"Np. okres wypowiedzenia","buttonText":"Szukaj","align":"wide"} /--></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Kategorie"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Kategorie</h2>
<!-- /wp:heading -->

<!-- wp:columns {"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Zmiana sprzedawcy</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Kolejność kroków, terminy operatora, pełnomocnictwo.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/category/zmiana-sprzedawcy/">Zobacz artykuły</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Umowy i wypowiedzenia</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Okres wypowiedzenia, klauzula prolongacyjna, koszty wcześniejszego rozwiązania.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/category/umowy-i-wypowiedzenia/">Zobacz artykuły</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Ceny i rynek</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Modele ceny, indeksy TGE, składniki faktury.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/category/ceny-i-rynek/">Zobacz artykuły</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column --></div>
<!-- /wp:columns -->

<!-- wp:columns {"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Biometan i raportowanie</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>CSRD, ETS, emisje Scope 1 z gazu, biometan.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/category/biometan-i-raportowanie/">Zobacz artykuły</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Sprzedaż rezerwowa</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Kiedy grozi, ile kosztuje, jak z niej wyjść.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/category/sprzedaz-rezerwowa/">Zobacz artykuły</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Komentarz rynkowy</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Notowania TGE, decyzje URE i zmiany przepisów, z autorem i datą.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/komentarz-rynkowy/">Zobacz komentarze</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column --></div>
<!-- /wp:columns --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Najnowsze wpisy"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Najnowsze artykuły</h2>
<!-- /wp:heading -->

<!-- wp:query {"queryId":31,"query":{"perPage":6,"pages":0,"offset":0,"postType":"post","order":"desc","orderBy":"date","author":"","search":"","exclude":[],"sticky":"exclude","inherit":false},"align":"wide","className":"gdp-komentarze"} -->
<div class="wp-block-query alignwide gdp-komentarze"><!-- wp:post-template {"layout":{"type":"grid","columnCount":3}} -->
<!-- wp:post-date {"fontSize":"xs"} /-->

<!-- wp:post-title {"level":3,"isLink":true,"fontSize":"m"} /-->

<!-- wp:post-excerpt {"moreText":"Czytaj dalej","excerptLength":24} /-->
<!-- /wp:post-template --></div>
<!-- /wp:query --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"CTA końcowe"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|80","bottom":"var:preset|spacing|80"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--80);padding-bottom:var(--wp--preset--spacing--80)"><!-- wp:block {"ref":"__BLOCK:cta-wgraj-fakture__"} /--></div>
<!-- /wp:group -->]]></content:encoded>
