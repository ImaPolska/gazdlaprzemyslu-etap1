	<item>
		<title><![CDATA[Pasek zaufania]]></title>
		<link>https://gazdlaprzemyslu.pl/pasek-zaufania/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=9009</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:columns {"metadata":{"name":"Pasek zaufania"},"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column -->
<div class="wp-block-column"><!-- wp:paragraph {"className":"gdp-liczba","metadata":{"name":"Element 1: wartość","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-liczba">Grupa IMA Polska</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-liczba-opis","metadata":{"name":"Element 1: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-liczba-opis">Właściciel PBM: bioetanol, biogaz, biometan [[opis aktywów]]</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:paragraph {"className":"gdp-liczba","metadata":{"name":"Element 2: wartość","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-liczba">Koncesja OPG</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-liczba-opis","metadata":{"name":"Element 2: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-liczba-opis">nr [[ ]] wydana przez Prezesa URE</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:paragraph {"className":"gdp-liczba","metadata":{"name":"Element 3: wartość","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-liczba">[[ ]] GWh</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-liczba-opis","metadata":{"name":"Element 3: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-liczba-opis">[[własne aktywa i wolumen Grupy]]</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:paragraph {"className":"gdp-liczba","metadata":{"name":"Element 4: wartość","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-liczba">24 h</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-liczba-opis","metadata":{"name":"Element 4: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-liczba-opis">od wgrania faktury do oferty indykatywnej</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column --></div>
<!-- /wp:columns -->]]></content:encoded>
