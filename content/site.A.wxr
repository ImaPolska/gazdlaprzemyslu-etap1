	<item>
		<title><![CDATA[Slot: formularz doradcy]]></title>
		<link>https://gazdlaprzemyslu.pl/slot-formularz-doradcy/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=9007</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Slot: formularz doradcy"},"className":"gdp-karta gdp-slot","layout":{"type":"constrained"}} -->
<div class="wp-block-group gdp-karta gdp-slot"><!-- wp:heading {"level":2,"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Zgłoś się jako doradca</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"className":"gdp-etykieta-pola"} -->
<p class="gdp-etykieta-pola">Imię i nazwisko</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole"} -->
<p class="gdp-pole">Jan Kowalski</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-etykieta-pola"} -->
<p class="gdp-etykieta-pola">Firma i NIP</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole"} -->
<p class="gdp-pole">Nazwa firmy, 10 cyfr</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-etykieta-pola"} -->
<p class="gdp-etykieta-pola">E-mail i telefon</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole"} -->
<p class="gdp-pole">imie.nazwisko@firma.pl, +48</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-etykieta-pola"} -->
<p class="gdp-etykieta-pola">Liczba punktów poboru w portfelu</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole"} -->
<p class="gdp-pole">do 10 / 10–50 / powyżej 50</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/kontakt/">Zgłoś się</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">[[treść zgody dostarczy zleceniodawca]] <a href="/polityka-prywatnosci/">Polityka prywatności</a></p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->]]></content:encoded>
