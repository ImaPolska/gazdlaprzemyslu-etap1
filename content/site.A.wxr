	<item>
		<title><![CDATA[Slot: analiza umowy]]></title>
		<link>https://gazdlaprzemyslu.pl/slot-analiza-umowy/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=9006</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Slot: analiza umowy"},"className":"gdp-slot","layout":{"type":"constrained"}} -->
<div class="wp-block-group gdp-slot"><!-- wp:columns {"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:heading {"level":2,"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Prześlij umowę do analizy</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"className":"gdp-pole gdp-pole-plik"} -->
<p class="gdp-pole gdp-pole-plik">Przeciągnij umowę (PDF) albo wybierz plik</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-etykieta-pola"} -->
<p class="gdp-etykieta-pola">E-mail służbowy</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole"} -->
<p class="gdp-pole">imie.nazwisko@twojafirma.pl</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/kontakt/">Prześlij umowę</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Każdy wynik analizy i każdy dokument sprawdza człowiek przed wysyłką. [[treść zgody dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Co odczytamy z umowy</h3>
<!-- /wp:heading -->

<!-- wp:list {"className":"gdp-lista-check"} -->
<ul class="wp-block-list gdp-lista-check"><!-- wp:list-item -->
<li>Datę zakończenia okresu obowiązywania</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Okres i formę wypowiedzenia</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Klauzulę prolongacyjną i jej warunki</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Opłaty za wcześniejsze rozwiązanie umowy</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Zadeklarowany wolumen i pasmo tolerancji</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Model ceny i formułę zmian ceny</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Nie sugerujemy rozwiązania umowy przed czasem. Skutki błędnego wypowiedzenia (sprzedaż rezerwowa, kary) ponosi klient, dlatego stosujemy kolejność: umowa z PBM, pełnomocnictwo, dopiero potem wypowiedzenie i zgłoszenie do OSD.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column --></div>
<!-- /wp:columns --></div>
<!-- /wp:group -->]]></content:encoded>
		<excerpt:encoded><![CDATA[]]></excerpt:encoded>
