		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Nagłówek strony"},"templateLock":"contentOnly","align":"full","className":"gdp-hero gdp-hero-produkt","style":{"spacing":{"padding":{"top":"var:preset|spacing|60","bottom":"var:preset|spacing|60"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull gdp-hero gdp-hero-produkt has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)"><!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Regulamin serwisu</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">Regulamin określa zasady korzystania z serwisu gazdlaprzemyslu.pl, w tym z narzędzi: wgrania faktury, kalkulatora terminu wypowiedzenia i analizy umowy, a także charakter ofert indykatywnych. Treść dostarczy zleceniodawca; poniżej struktura sekcji.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Treść dokumentu"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Postanowienia ogólne</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>[[treść dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading">Definicje</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>[[treść dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading">Usługi świadczone w serwisie</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>[[treść dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading">Oferta indykatywna a oferta wiążąca</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>[[treść dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading">Narzędzia: kalkulator i analiza umowy</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>[[treść dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading">Odpowiedzialność</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>[[treść dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading">Reklamacje</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>[[treść dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
