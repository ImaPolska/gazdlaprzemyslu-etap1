	<item>
		<title><![CDATA[Komentarz rynkowy: tydzień [[nr tygodnia]] 2026 (drugi szablon)]]></title>
		<link>https://gazdlaprzemyslu.pl/wiedza/komentarz-rynkowy-szablon-2/</link>
		<pubDate>Tue, 01 Sep 2026 09:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=2002</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Komentarz rynkowy · [[data publikacji]] · Autor: [[imię i nazwisko, stanowisko]]</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">[[Jedno lub dwa zdania: główny temat tygodnia i skutek dla odbiorcy.]]</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Temat tygodnia</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>[[Trzy do pięciu zdań opisu wydarzenia ze źródłem.]]</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Notowania TGE</h2>
<!-- /wp:heading -->

<!-- wp:table {"hasFixedLayout":false,"className":"gdp-liczby"} -->
<figure class="wp-block-table gdp-liczby"><table><thead><tr><th>Instrument</th><th>Cena (zł/MWh)</th><th>Zmiana tydzień do tygodnia</th></tr></thead><tbody><tr><td>[[ ]]</td><td>[[ ]]</td><td>[[ ]]</td></tr></tbody></table><figcaption class="wp-element-caption">Źródło: Towarowa Giełda Energii, stan na [[data]].</figcaption></figure>
<!-- /wp:table -->

<!-- wp:heading {"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Co to znaczy dla Twojej umowy</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>[[Dwa lub trzy zdania. Bez rekomendacji zakupu i bez prognoz.]]</p>
<!-- /wp:paragraph -->

<!-- wp:block {"ref":"__BLOCK:zastrzezenie-cen__"} /-->

<!-- wp:group {"metadata":{"name":"Źródła i aktualizacja"},"className":"gdp-karta","layout":{"type":"constrained"}} -->
<div class="wp-block-group gdp-karta"><!-- wp:heading {"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Źródła</h2>
<!-- /wp:heading -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Towarowa Giełda Energii, Rynek Terminowy Towarowy gazu i indeksy – <a href="https://tge.pl">tge.pl</a></li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Urząd Regulacji Energetyki – <a href="https://www.ure.gov.pl">ure.gov.pl</a></li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Ostatnia aktualizacja: [[data]] · Autor: [[imię i nazwisko, stanowisko]]</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->]]></content:encoded>
		<excerpt:encoded><![CDATA[Szablon komentarza rynkowego z sekcją o zmianach w przepisach. Liczby i treść uzupełnia autor.]]></excerpt:encoded>
		<wp:post_id>2002</wp:post_id>
		<wp:post_date><![CDATA[2026-09-01 09:00:00]]></wp:post_date>
		<wp:post_date_gmt><![CDATA[2026-09-01 09:00:00]]></wp:post_date_gmt>
		<wp:post_modified><![CDATA[2026-09-01 09:00:00]]></wp:post_modified>
