	<item>
		<title><![CDATA[Wzorzec: segmenty]]></title>
		<link>https://gazdlaprzemyslu.pl/wzorzec-segmenty/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=9008</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:columns {"metadata":{"name":"Wzorzec: segmenty"},"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:paragraph {"className":"gdp-etykieta"} -->
<p class="gdp-etykieta">Mniejsza firma</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"metadata":{"name":"Segment 1: nagłówek","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<h3 class="wp-block-heading">Zużywasz do [[X]] GWh gazu rocznie</h3>
<!-- /wp:heading -->

<!-- wp:paragraph {"metadata":{"name":"Segment 1: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p>Szybka ścieżka. Wgrywasz fakturę, w 24 godziny dostajesz ofertę. Umowa kompleksowa albo sprzedażowa, bez wizyty handlowca.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/dla-kogo/msp/">Oferta dla MŚP</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:paragraph {"className":"gdp-etykieta"} -->
<p class="gdp-etykieta">Przemysł</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"metadata":{"name":"Segment 2: nagłówek","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<h3 class="wp-block-heading">Zużywasz powyżej [[X]] GWh gazu rocznie</h3>
<!-- /wp:heading -->

<!-- wp:paragraph {"metadata":{"name":"Segment 2: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p>Dostajesz opiekuna. Razem ustalacie profil zużycia, model ceny (stała, indeksowana, transze) i harmonogram zakupów.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/dla-kogo/przemysl/">Oferta dla przemysłu</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:paragraph {"className":"gdp-etykieta"} -->
<p class="gdp-etykieta">Doradca</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"metadata":{"name":"Segment 3: nagłówek","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<h3 class="wp-block-heading">Obsługujesz portfel klientów</h3>
<!-- /wp:heading -->

<!-- wp:paragraph {"metadata":{"name":"Segment 3: opis","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p>Jedno okno zgłoszeń dla wielu punktów poboru, warunki współpracy [[model współpracy]] i status każdej sprawy.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button {"className":"is-style-outline"} -->
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="/dla-doradcow/">Dla doradców</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column --></div>
<!-- /wp:columns -->]]></content:encoded>
