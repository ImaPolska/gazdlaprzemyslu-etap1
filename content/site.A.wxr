	</item>
	<item>
		<title><![CDATA[Komentarz rynkowy: tydzień [[nr tygodnia]] 2026]]></title>
		<link>https://gazdlaprzemyslu.pl/wiedza/komentarz-rynkowy-szablon-1/</link>
		<pubDate>Tue, 08 Sep 2026 09:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=2001</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Komentarz rynkowy · [[data publikacji]] · Autor: [[imię i nazwisko, stanowisko]]</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">[[Jedno lub dwa zdania: co wydarzyło się na rynku w tym tygodniu i jaki ma to skutek dla odbiorcy. Bez prognoz.]]</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Notowania TGE</h2>
<!-- /wp:heading -->

<!-- wp:table {"hasFixedLayout":false,"className":"gdp-liczby"} -->
<figure class="wp-block-table gdp-liczby"><table><thead><tr><th>Instrument</th><th>Cena (zł/MWh)</th><th>Zmiana tydzień do tygodnia</th></tr></thead><tbody><tr><td>[[np. RDNg, indeks]]</td><td>[[ ]]</td><td>[[ ]]</td></tr><tr><td>[[np. kontrakt na kolejny rok]]</td><td>[[ ]]</td><td>[[ ]]</td></tr></tbody></table><figcaption class="wp-element-caption">Źródło: Towarowa Giełda Energii, stan na [[data]].</figcaption></figure>
<!-- /wp:table -->

<!-- wp:heading {"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Decyzje i przepisy</h2>
<!-- /wp:heading -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>[[decyzja Prezesa URE albo zmiana przepisu, z datą]]</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>[[druga pozycja albo usuń]]</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:heading {"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Co to znaczy dla Twojej umowy</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>[[Dwa lub trzy zdania odnoszące zmiany do modeli ceny: stała, indeksowana, transze. Bez rekomendacji zakupu.]]</p>
<!-- /wp:paragraph -->

<!-- wp:block {"ref":"__BLOCK:zastrzezenie-cen__"} /-->

<!-- wp:group {"metadata":{"name":"Źródła i aktualizacja"},"className":"gdp-karta","layout":{"type":"constrained"}} -->
<div class="wp-block-group gdp-karta"><!-- wp:heading {"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Źródła</h2>
<!-- /wp:heading -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Towarowa Giełda Energii, Rynek Terminowy Towarowy gazu i indeksy – <a href="https://tge.pl">tge.pl</a></li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Urząd Regulacji Energetyki – <a href="https://www.ure.gov.pl">ure.gov.pl</a></li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Ostatnia aktualizacja: [[data]] · Autor: [[imię i nazwisko, stanowisko]]</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->]]></content:encoded>
		<excerpt:encoded><![CDATA[Co zmieniło się na rynku gazu w tym tygodniu i co to znaczy dla umowy odbiorcy przemysłowego. Szablon wpisu; liczby uzupełnia autor.]]></excerpt:encoded>
		<wp:post_id>2001</wp:post_id>
