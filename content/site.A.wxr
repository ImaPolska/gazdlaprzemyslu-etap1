		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"CTA: wgraj fakturę"},"layout":{"type":"constrained","justifyContent":"center"}} -->
<div class="wp-block-group"><!-- wp:heading {"textAlign":"center","metadata":{"name":"Nagłówek CTA","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<h2 class="wp-block-heading has-text-align-center">Wgraj fakturę. Ofertę dostaniesz w 24 godziny.</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"align":"center","fontSize":"m","metadata":{"name":"Podtytuł CTA","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="has-text-align-center has-m-font-size">Bez zobowiązań. Jeżeli wolisz rozmowę, opiekun oddzwoni w terminie, który wskażesz.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons {"className":"gdp-cta-duzy","layout":{"type":"flex","justifyContent":"center"}} -->
<div class="wp-block-buttons gdp-cta-duzy"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/wgraj-fakture/">Wgraj fakturę</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:group -->]]></content:encoded>
