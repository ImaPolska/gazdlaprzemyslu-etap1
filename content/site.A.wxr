	<item>
		<title><![CDATA[Dokumenty]]></title>
		<link>https://gazdlaprzemyslu.pl/dokumenty/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=1020</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Nagłówek strony"},"templateLock":"contentOnly","align":"full","className":"gdp-hero gdp-hero-produkt","style":{"spacing":{"padding":{"top":"var:preset|spacing|60","bottom":"var:preset|spacing|60"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull gdp-hero gdp-hero-produkt has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)"><!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Dokumenty</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">Dokumenty wymagane przepisami i potrzebne do zawarcia umowy: koncesja, cennik dla odbiorców biznesowych, informacja o strukturze paliw, ogólne warunki umów, wzory pełnomocnictw, polityka prywatności i decyzje Prezesa URE. Każdy wiersz zawiera nazwę, datę i plik PDF.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Lista dokumentów"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:table {"hasFixedLayout":false,"align":"wide"} -->
<figure class="wp-block-table alignwide"><table><thead><tr><th>Dokument</th><th>Rodzaj</th><th>Data publikacji</th><th>Plik</th></tr></thead><tbody><tr><td>Koncesja na obrót paliwami gazowymi (OPG)</td><td>Decyzja Prezesa URE</td><td>[[data]]</td><td><a href="/kontakt/">PDF [[plik]]</a></td></tr><tr><td>Cennik paliw gazowych dla odbiorców biznesowych</td><td>Cennik</td><td>[[data]]</td><td><a href="/kontakt/">PDF [[plik]]</a></td></tr><tr><td>Struktura paliw gazowych i wpływ na środowisko</td><td>Informacja ustawowa</td><td>[[data]]</td><td><a href="/kontakt/">PDF [[plik]]</a></td></tr><tr><td>Regulamin serwisu gazdlaprzemyslu.pl</td><td>Regulamin</td><td>[[data]]</td><td><a href="/kontakt/">PDF [[plik]]</a></td></tr><tr><td>Ogólne warunki umowy sprzedaży paliw gazowych</td><td>OWU</td><td>[[data]]</td><td><a href="/kontakt/">PDF [[plik]]</a></td></tr><tr><td>Ogólne warunki umowy kompleksowej</td><td>OWU</td><td>[[data]]</td><td><a href="/kontakt/">PDF [[plik]]</a></td></tr><tr><td>Wzór pełnomocnictwa do zmiany sprzedawcy</td><td>Wzór</td><td>[[data]]</td><td><a href="/kontakt/">PDF [[plik]]</a></td></tr><tr><td>Polityka prywatności i informacja o przetwarzaniu danych</td><td>RODO</td><td>[[data]]</td><td><a href="/kontakt/">PDF [[plik]]</a></td></tr><tr><td>Decyzje Prezesa URE dotyczące PBM</td><td>Decyzje</td><td>[[data]]</td><td><a href="/kontakt/">PDF [[plik]]</a></td></tr><tr><td>Wykaz sprzedawców rezerwowych u operatorów</td><td>Informacja</td><td>[[data]]</td><td><a href="/kontakt/">PDF [[plik]]</a></td></tr></tbody></table><figcaption class="wp-element-caption">Pliki dostarczy zleceniodawca. Wiersz tabeli jest wzorcem „wiersz dokumentu”.</figcaption></figure>
<!-- /wp:table --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Źródła i aktualizacja"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|50","bottom":"var:preset|spacing|50"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)"><!-- wp:heading {"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Źródła</h2>
<!-- /wp:heading -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Ustawa z dnia 10 kwietnia 1997 r. – Prawo energetyczne (tekst jednolity) – <a href="https://isap.sejm.gov.pl">isap.sejm.gov.pl</a></li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Urząd Regulacji Energetyki – <a href="https://www.ure.gov.pl">ure.gov.pl</a></li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Ostatnia aktualizacja: [[data]] · Autor: PBM Sp. z o.o.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->]]></content:encoded>
		<excerpt:encoded><![CDATA[]]></excerpt:encoded>
		<wp:post_id>1020</wp:post_id>
