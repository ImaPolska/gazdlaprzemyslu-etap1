	<item>
		<title><![CDATA[Slot: tabela cen]]></title>
		<link>https://gazdlaprzemyslu.pl/slot-tabela-cen/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=9004</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Slot: tabela cen"},"layout":{"type":"constrained"}} -->
<div class="wp-block-group"><!-- wp:table {"hasFixedLayout":false,"className":"gdp-liczby"} -->
<figure class="wp-block-table gdp-liczby"><table><thead><tr><th>Model ceny</th><th>Pasmo ceny gazu netto [[zł/MWh]]</th><th>Okres umowy</th><th>Dla kogo</th></tr></thead><tbody><tr><td>Cena stała</td><td>[[ ]] – [[ ]]</td><td>[[ ]]</td><td>Stabilne zużycie, budżet na rok naprzód</td></tr><tr><td>Cena indeksowana TGE</td><td>indeks [[ ]] + [[ ]]</td><td>[[ ]]</td><td>Akceptujesz zmienność, chcesz ceny rynkowej</td></tr><tr><td>Model transzowy</td><td>[[ ]] – [[ ]]</td><td>[[ ]]</td><td>Duży wolumen, zakupy w kilku terminach</td></tr><tr><td>Umowa kompleksowa dla MŚP</td><td>[[ ]] – [[ ]]</td><td>[[ ]]</td><td>Jedna faktura za gaz i dystrybucję</td></tr></tbody></table><figcaption class="wp-element-caption">Pasma nie zawierają opłat dystrybucyjnych, akcyzy ani podatków. Szczegóły: <a href="/ceny-orientacyjne/">ceny orientacyjne</a>.</figcaption></figure>
<!-- /wp:table -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy","metadata":{"name":"Data aktualizacji","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p class="gdp-tekst-pomocniczy">Ostatnia aktualizacja pasm: [[data]]</p>
<!-- /wp:paragraph -->

<!-- wp:block {"ref":"__BLOCK:zastrzezenie-cen__"} /--></div>
<!-- /wp:group -->]]></content:encoded>
