		<wp:post_password><![CDATA[]]></wp:post_password>
		<wp:is_sticky>0</wp:is_sticky>
	</item>
	<item>
		<title><![CDATA[Wgraj fakturę]]></title>
		<link>https://gazdlaprzemyslu.pl/wgraj-fakture/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=1002</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Nagłówek strony"},"templateLock":"contentOnly","align":"full","className":"gdp-hero gdp-hero-produkt","style":{"spacing":{"padding":{"top":"var:preset|spacing|60","bottom":"var:preset|spacing|60"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull gdp-hero gdp-hero-produkt has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)"><!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Wgraj fakturę za gaz i odbierz ofertę w 24 godziny</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">Wystarczy jedna strona faktury z danymi punktu poboru. Odczytamy z niej taryfę, zużycie i termin obecnej umowy, a w ciągu 24 godzin roboczych [[potwierdzić SLA]] prześlemy ofertę indykatywną w wybranym modelu ceny. Bez telefonu od handlowca, dopóki sam o niego nie poprosisz.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Slot: upload faktury"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:block {"ref":"__BLOCK:slot-upload-faktury__"} /--></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Co odczytamy z faktury"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Co odczytamy z Twojej faktury</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Faktura za gaz zawiera wszystko, czego potrzebujemy do przygotowania oferty. Nie musisz niczego przepisywać.</p>
<!-- /wp:paragraph -->

<!-- wp:columns {"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column -->
<div class="wp-block-column"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Dane punktu poboru</h3>
<!-- /wp:heading -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Numer punktu poboru (ID PP) i adres</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Operator systemu dystrybucyjnego</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Grupa taryfowa dystrybucji, np. W-5 albo W-6 [[potwierdzić przykłady]]</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Moc umowna, jeśli jest wskazana</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Dane zużycia i ceny</h3>
<!-- /wp:heading -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Zużycie w okresie rozliczeniowym w kWh lub MWh</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Cena gazu jako paliwa i opłata abonamentowa</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Opłaty dystrybucyjne stałe i zmienne</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Akcyza i inne opłaty ustawowe</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Dane umowy</h3>
<!-- /wp:heading -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Obecny sprzedawca</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Okres rozliczeniowy</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Termin obowiązywania umowy, jeśli jest podany</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>NIP i dane rejestrowe Twojej firmy</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list --></div>
<!-- /wp:column --></div>
<!-- /wp:columns -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Jeśli masz kilka punktów poboru, wgraj po jednej fakturze na każdy z nich albo prześlij zestawienie w jednym pliku.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Co dostaniesz w 24 godziny"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Co dostaniesz w 24 godziny</h2>
<!-- /wp:heading -->

<!-- wp:columns {"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column -->
<div class="wp-block-column"><!-- wp:paragraph {"className":"gdp-krok-numer"} -->
<p class="gdp-krok-numer">01</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Potwierdzenie odczytu</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>E-mail z danymi odczytanymi z faktury do Twojej akceptacji. Poprawiasz je jednym kliknięciem, jeśli coś się nie zgadza.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:paragraph {"className":"gdp-krok-numer"} -->
<p class="gdp-krok-numer">02</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Oferta indykatywna</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Pasmo ceny w wybranym modelu (stała, indeksowana TGE, transzowy), założenia dotyczące wolumenu i okres obowiązywania oferty.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:paragraph {"className":"gdp-krok-numer"} -->
<p class="gdp-krok-numer">03</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Analiza terminu</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Najbliższy bezpieczny termin zmiany sprzedawcy wyliczony z Twojej obecnej umowy, o ile ją prześlesz.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:paragraph {"className":"gdp-krok-numer"} -->
<p class="gdp-krok-numer">04</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Lista dokumentów</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Czego potrzebujemy do podpisania umowy: dane rejestrowe, pełnomocnictwo, ewentualnie umowa dystrybucyjna.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column --></div>
<!-- /wp:columns --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Bezpieczeństwo danych"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Jak chronimy dane z Twojej faktury</h2>
<!-- /wp:heading -->

<!-- wp:columns {"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column -->
<div class="wp-block-column"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Zakres i cel</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Dane z faktury wykorzystujemy wyłącznie do przygotowania oferty i, po Twojej zgodzie, do zawarcia umowy. Nie przekazujemy ich podmiotom trzecim poza operatorem systemu w procedurze zmiany sprzedawcy.</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Retencja</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Plik faktury przechowujemy przez [[okres retencji]] od przesłania, a po tym czasie usuwamy, chyba że zawrzemy umowę. Szczegóły w <a href="/polityka-prywatnosci/">polityce prywatności</a>.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Administrator danych</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>PBM Sp. z o.o., [[adres siedziby]]. Kontakt w sprawach danych osobowych: [[adres e-mail IOD lub kontakt]].</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Twoje prawa</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Masz prawo dostępu do danych, ich sprostowania, usunięcia i ograniczenia przetwarzania. Wniosek wysyłasz na adres wskazany w polityce prywatności.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column --></div>
<!-- /wp:columns --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"FAQ"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Pytania o wgranie faktury</h2>
<!-- /wp:heading -->

<!-- wp:details -->
<details class="wp-block-details"><summary>Czy wgranie faktury do czegoś mnie zobowiązuje?</summary><!-- wp:paragraph -->
<p>Nie. Oferta indykatywna jest bezpłatna i niewiążąca. Decyzję podejmujesz po jej otrzymaniu.</p>
<!-- /wp:paragraph --></details>
<!-- /wp:details -->

<!-- wp:details -->
<details class="wp-block-details"><summary>Jaki plik mogę wgrać?</summary><!-- wp:paragraph -->
<p>PDF, JPG albo PNG do [[limit rozmiaru]]. Zdjęcie faktury z telefonu wystarczy, jeśli dane są czytelne.</p>
<!-- /wp:paragraph --></details>
<!-- /wp:details -->

<!-- wp:details -->
<details class="wp-block-details"><summary>Czy oferta w 24 godziny jest wiążąca?</summary><!-- wp:paragraph -->
<p>Oferta indykatywna pokazuje pasmo ceny i założenia. Ofertę wiążącą dostaniesz po potwierdzeniu wolumenu i terminu, przed podpisaniem umowy.</p>
<!-- /wp:paragraph --></details>
<!-- /wp:details -->

<!-- wp:details -->
<details class="wp-block-details"><summary>Co, jeśli moja umowa kończy się dopiero za rok?</summary><!-- wp:paragraph -->
<p>Wyliczymy termin i przypomnimy o nim z wyprzedzeniem. Możesz też zabezpieczyć cenę wcześniej, jeśli wybierzesz umowę z odroczonym startem dostaw [[warunki]].</p>
<!-- /wp:paragraph --></details>
<!-- /wp:details -->

<!-- wp:details -->
<details class="wp-block-details"><summary>Kto zobaczy moją fakturę?</summary><!-- wp:paragraph -->
<p>Zespół ofertowy PBM. Dane odczytujemy z pomocą narzędzia do ekstrakcji [[opis rozwiązania w etapie 4]] i weryfikuje je człowiek.</p>
<!-- /wp:paragraph --></details>
<!-- /wp:details -->

<!-- wp:details -->
<details class="wp-block-details"><summary>Czy muszę wypowiadać obecną umowę samodzielnie?</summary><!-- wp:paragraph -->
<p>Nie. Po podpisaniu umowy z PBM i pełnomocnictwa wypowiadamy ją za Ciebie w jej terminie i zgłaszamy zmianę do operatora.</p>
<!-- /wp:paragraph --></details>
<!-- /wp:details --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"CTA końcowe"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|80","bottom":"var:preset|spacing|80"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--80);padding-bottom:var(--wp--preset--spacing--80)"><!-- wp:block {"ref":"__BLOCK:cta-wgraj-fakture__"} /--></div>
<!-- /wp:group -->]]></content:encoded>
		<excerpt:encoded><![CDATA[]]></excerpt:encoded>
		<wp:post_id>1002</wp:post_id>
		<wp:post_date><![CDATA[2026-09-13 12:00:00]]></wp:post_date>
		<wp:post_date_gmt><![CDATA[2026-09-13 12:00:00]]></wp:post_date_gmt>
		<wp:post_modified><![CDATA[2026-09-13 12:00:00]]></wp:post_modified>
		<wp:post_modified_gmt><![CDATA[2026-09-13 12:00:00]]></wp:post_modified_gmt>
		<wp:comment_status><![CDATA[closed]]></wp:comment_status>
		<wp:ping_status><![CDATA[closed]]></wp:ping_status>
		<wp:post_name><![CDATA[wgraj-fakture]]></wp:post_name>
		<wp:status><![CDATA[publish]]></wp:status>
		<wp:post_parent>0</wp:post_parent>
		<wp:menu_order>0</wp:menu_order>
		<wp:post_type><![CDATA[page]]></wp:post_type>
		<wp:post_password><![CDATA[]]></wp:post_password>
		<wp:is_sticky>0</wp:is_sticky>
	</item>
	<item>
		<title><![CDATA[Oferta]]></title>
		<link>https://gazdlaprzemyslu.pl/oferta/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=1003</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Nagłówek strony"},"templateLock":"contentOnly","align":"full","className":"gdp-hero gdp-hero-produkt","style":{"spacing":{"padding":{"top":"var:preset|spacing|60","bottom":"var:preset|spacing|60"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull gdp-hero gdp-hero-produkt has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)"><!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Pięć modeli zakupu gazu dla firm</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">Wybierasz sposób ustalania ceny gazu, nie sprzedawcę „w pakiecie”. Cena stała daje przewidywalność, cena indeksowana do TGE podąża za rynkiem, model transzowy łączy oba podejścia. MŚP mogą dodatkowo wybrać umowę kompleksową, a biometan z aktywów Grupy IMA przygotowujemy.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/wgraj-fakture/">Wgraj fakturę</a></div>
<!-- /wp:button -->

<!-- wp:button {"className":"is-style-outline"} -->
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="/ceny-orientacyjne/">Zobacz pasma cen</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Karty produktów"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Modele ceny</h2>
<!-- /wp:heading -->

<!-- wp:columns {"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:paragraph {"className":"gdp-etykieta"} -->
<p class="gdp-etykieta">Przewidywalność</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Cena stała</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Jedna stawka za MWh przez cały okres umowy. Budżet gazu zależy tylko od wolumenu.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/oferta/cena-stala/">Cena stała</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:paragraph {"className":"gdp-etykieta"} -->
<p class="gdp-etykieta">Rynek</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Cena indeksowana TGE</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Cena zmienia się z publikowanym indeksem TGE plus stała marża. Korzystasz ze spadków, ponosisz ryzyko wzrostów.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/oferta/cena-indeksowana-tge/">Cena indeksowana</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:paragraph {"className":"gdp-etykieta"} -->
<p class="gdp-etykieta">Etapami</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Model transzowy</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Wolumen dzielisz na transze i ustalasz ich cenę w różnych momentach. Uśredniasz cenę zakupu.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/oferta/model-transzowy/">Model transzowy</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column --></div>
<!-- /wp:columns -->

<!-- wp:columns {"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:paragraph {"className":"gdp-etykieta"} -->
<p class="gdp-etykieta">MŚP</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Umowa kompleksowa dla MŚP</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Sprzedaż i dystrybucja na jednej fakturze, jeśli PBM ma generalną umowę dystrybucyjną z Twoim operatorem. Jeśli nie, pomożemy zawrzeć umowę dystrybucyjną osobno.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/oferta/umowa-kompleksowa-msp/">Umowa kompleksowa</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:paragraph {"className":"gdp-etykieta"} -->
<p class="gdp-etykieta">Wkrótce</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Biometan</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Biometan z instalacji Grupy IMA Polska. Bez cen i terminów na tym etapie. Zostaw kontakt, a poinformujemy Cię o starcie.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/oferta/biometan/">Biometan</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:paragraph {"className":"gdp-etykieta"} -->
<p class="gdp-etykieta">Nie wiesz, który?</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Wgraj fakturę</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Na podstawie profilu zużycia wskażemy model, który pasuje do Twojego zakładu, i pokażemy pasmo ceny w każdym z nich.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/wgraj-fakture/">Wgraj fakturę</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:column --></div>
<!-- /wp:columns --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Tabela porównawcza"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Porównanie modeli</h2>
<!-- /wp:heading -->

<!-- wp:table {"hasFixedLayout":false,"align":"wide"} -->
<figure class="wp-block-table alignwide"><table><thead><tr><th>Cecha</th><th>Cena stała</th><th>Cena indeksowana TGE</th><th>Model transzowy</th><th>Umowa kompleksowa MŚP</th></tr></thead><tbody><tr><td>Jak ustalana jest cena gazu</td><td>Stawka z umowy</td><td>Indeks TGE + marża</td><td>Średnia z transz</td><td>Stała albo indeksowana [[warunki]]</td></tr><tr><td>Kto ponosi ryzyko wzrostu cen</td><td>PBM</td><td>Ty</td><td>Podzielone</td><td>Zależnie od wariantu</td></tr><tr><td>Kto korzysta ze spadku cen</td><td>PBM</td><td>Ty</td><td>Podzielone</td><td>Zależnie od wariantu</td></tr><tr><td>Wymagane decyzje w trakcie umowy</td><td>Brak</td><td>Brak</td><td>Terminy zamknięcia transz</td><td>Brak</td></tr><tr><td>Typowy okres umowy</td><td>[[ ]]</td><td>[[ ]]</td><td>[[ ]]</td><td>[[ ]]</td></tr><tr><td>Minimalne zużycie roczne</td><td>[[ ]]</td><td>[[ ]]</td><td>[[ ]]</td><td>do [[X]] GWh</td></tr><tr><td>Dystrybucja na tej samej fakturze</td><td>Nie</td><td>Nie</td><td>Nie</td><td>Tak, jeśli PBM ma GUD z Twoim OSD</td></tr></tbody></table><figcaption class="wp-element-caption">Porównanie ma charakter opisowy. Warunki liczbowe uzupełni PBM.</figcaption></figure>
<!-- /wp:table --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Dla kogo który model"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Który model pasuje do Twojego zakładu</h2>
<!-- /wp:heading -->

<!-- wp:table {"hasFixedLayout":false} -->
<figure class="wp-block-table"><table><thead><tr><th>Twoja sytuacja</th><th>Rozważ</th></tr></thead><tbody><tr><td>Budżetujesz koszt gazu na rok naprzód i nie chcesz śledzić notowań</td><td><a href="/oferta/cena-stala/">Cena stała</a></td></tr><tr><td>Masz dział zakupów, który obserwuje rynek, i akceptujesz zmienność</td><td><a href="/oferta/cena-indeksowana-tge/">Cena indeksowana TGE</a></td></tr><tr><td>Zużywasz kilkadziesiąt GWh i więcej, chcesz uśredniać cenę zakupu</td><td><a href="/oferta/model-transzowy/">Model transzowy</a></td></tr><tr><td>Prowadzisz piekarnię, suszarnię, szklarnię albo inną mniejszą firmę i chcesz jednej faktury</td><td><a href="/oferta/umowa-kompleksowa-msp/">Umowa kompleksowa</a></td></tr><tr><td>Raportujesz emisje i szukasz paliwa o niższym śladzie</td><td><a href="/oferta/biometan/">Biometan (wkrótce)</a></td></tr></tbody></table></figure>
<!-- /wp:table --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"CTA końcowe"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|80","bottom":"var:preset|spacing|80"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--80);padding-bottom:var(--wp--preset--spacing--80)"><!-- wp:block {"ref":"__BLOCK:cta-wgraj-fakture__"} /--></div>
<!-- /wp:group -->]]></content:encoded>
		<excerpt:encoded><![CDATA[]]></excerpt:encoded>
		<wp:post_id>1003</wp:post_id>
		<wp:post_date><![CDATA[2026-09-13 12:00:00]]></wp:post_date>
		<wp:post_date_gmt><![CDATA[2026-09-13 12:00:00]]></wp:post_date_gmt>
		<wp:post_modified><![CDATA[2026-09-13 12:00:00]]></wp:post_modified>
		<wp:post_modified_gmt><![CDATA[2026-09-13 12:00:00]]></wp:post_modified_gmt>
		<wp:comment_status><![CDATA[closed]]></wp:comment_status>
		<wp:ping_status><![CDATA[closed]]></wp:ping_status>
		<wp:post_name><![CDATA[oferta]]></wp:post_name>
		<wp:status><![CDATA[publish]]></wp:status>
		<wp:post_parent>0</wp:post_parent>
		<wp:menu_order>0</wp:menu_order>
		<wp:post_type><![CDATA[page]]></wp:post_type>
		<wp:post_password><![CDATA[]]></wp:post_password>
		<wp:is_sticky>0</wp:is_sticky>
	</item>
	<item>
		<title><![CDATA[Cena stała]]></title>
		<link>https://gazdlaprzemyslu.pl/cena-stala/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=1004</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Hero produktu"},"templateLock":"contentOnly","align":"full","className":"gdp-hero gdp-hero-produkt","style":{"spacing":{"padding":{"top":"var:preset|spacing|60","bottom":"var:preset|spacing|60"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull gdp-hero gdp-hero-produkt has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)"><!-- wp:paragraph {"className":"gdp-etykieta"} -->
<p class="gdp-etykieta"><a href="/oferta/">Oferta</a> · Cena stała</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Cena stała gazu dla firm</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"fontSize":"m"} -->
<p class="has-m-font-size">Cena stała to jedna stawka za MWh gazu przez cały okres umowy, zwykle [[12 albo 24 miesiące]]. Płacisz tyle samo niezależnie od notowań na TGE. Wybierasz ją, gdy przewidywalność kosztu jest dla Ciebie ważniejsza niż szansa na niższą cenę przy spadkach rynku.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/wgraj-fakture/">Wgraj fakturę</a></div>
<!-- /wp:button -->

<!-- wp:button {"className":"is-style-outline"} -->
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="/oferta/">Porównaj modele ceny</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Dla kogo"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Dla kogo jest cena stała</h2>
<!-- /wp:heading -->

<!-- wp:columns {"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Budżetujesz koszt gazu na rok naprzód</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Znasz stawkę za MWh w dniu podpisania umowy. Koszt paliwa w budżecie zależy tylko od wolumenu.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Zużycie jest stabilne i przewidywalne</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Deklarujesz wolumen na podstawie historii z faktur. Im mniejsze odchylenia, tym prostsze rozliczenie.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column {"className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Nie chcesz śledzić notowań TGE</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Decyzję o cenie podejmujesz raz, przy podpisaniu umowy. Potem zajmujesz się produkcją, nie rynkiem.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column --></div>
<!-- /wp:columns -->

<!-- wp:paragraph -->
<p>Rozważ inny model, gdy Twoje zużycie jest sezonowe albo oczekujesz spadku cen w okresie umowy. Zobacz <a href="/oferta/cena-indeksowana-tge/">cenę indeksowaną TGE</a> i <a href="/oferta/model-transzowy/">model transzowy</a>.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Mechanizm"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Jak działa cena stała</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Stała jest cena gazu jako paliwa. Pozostałe składniki faktury wynikają z taryfy operatora i przepisów, więc zmieniają się niezależnie od umowy sprzedaży.</p>
<!-- /wp:paragraph -->

<!-- wp:table {"hasFixedLayout":false} -->
<figure class="wp-block-table"><table><thead><tr><th>Składnik faktury</th><th>Kto ustala</th><th>Stały w okresie umowy</th></tr></thead><tbody><tr><td>Cena gazu (zł/MWh)</td><td>PBM, w umowie</td><td>Tak</td></tr><tr><td>Opłata handlowa / abonamentowa</td><td>PBM, w umowie</td><td>Tak [[warunki]]</td></tr><tr><td>Opłaty dystrybucyjne</td><td>Operator systemu dystrybucyjnego, taryfa zatwierdzana przez Prezesa URE</td><td>Nie, zgodnie z taryfą</td></tr><tr><td>Akcyza, VAT, inne opłaty ustawowe</td><td>Przepisy prawa</td><td>Nie, zgodnie z przepisami</td></tr></tbody></table></figure>
<!-- /wp:table -->

<!-- wp:list {"ordered":true} -->
<ol class="wp-block-list"><!-- wp:list-item -->
<li>Z faktury odczytujemy Twój profil zużycia i grupę taryfową.</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Proponujemy cenę stałą na okres [[ ]] wraz z pasmem tolerancji wolumenu [[ ]].</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Podpisujesz umowę i pełnomocnictwo. Wypowiedzenie obecnej umowy składamy w jej terminie, nie wcześniej.</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Od pierwszego dnia dostawy płacisz stałą cenę za każdą MWh do końca umowy.</li>
<!-- /wp:list-item --></ol>
<!-- /wp:list --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Ryzyka i ograniczenia"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Ryzyka i ograniczenia</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Cena stała chroni przed wzrostem cen, ale ma cenę w postaci rezygnacji z korzyści przy spadkach. Zanim ją wybierzesz, sprawdź cztery punkty.</p>
<!-- /wp:paragraph -->

<!-- wp:columns {"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column -->
<div class="wp-block-column"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Spadek cen na rynku</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Gdy notowania spadną, płacisz cenę z umowy. To świadoma zamiana szansy na przewidywalność.</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Odchylenia wolumenu</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Zużycie poza pasmem tolerancji [[ ]] rozliczamy według zasad z umowy. Deklaruj wolumen na podstawie historii, nie planów.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Wcześniejsze rozwiązanie umowy</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Może wiązać się z opłatą określoną w umowie [[warunki]]. Dotyczy to także Twojej obecnej umowy, dlatego nigdy nie wypowiadamy jej przed terminem.</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3,"fontSize":"m"} -->
<h3 class="wp-block-heading has-m-font-size">Składniki poza ceną gazu</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Dystrybucja, akcyza i podatki zmieniają się niezależnie od umowy sprzedaży. Cena stała ich nie obejmuje.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column --></div>
<!-- /wp:columns --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Przykład liczbowy"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Przykład liczbowy</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Przykład dla zakładu o zużyciu [[ ]] MWh rocznie. Wszystkie wartości uzupełni PBM na podstawie aktualnych warunków.</p>
<!-- /wp:paragraph -->

<!-- wp:table {"hasFixedLayout":false,"className":"gdp-liczby"} -->
<figure class="wp-block-table gdp-liczby"><table><thead><tr><th>Pozycja</th><th>Wartość</th><th>Jednostka</th></tr></thead><tbody><tr><td>Zużycie roczne</td><td>[[ ]]</td><td>MWh</td></tr><tr><td>Cena stała gazu</td><td>[[ ]]</td><td>zł/MWh netto</td></tr><tr><td>Koszt gazu w roku</td><td>[[ ]]</td><td>zł netto</td></tr><tr><td>Opłaty dystrybucyjne wg taryfy [[grupa taryfowa]]</td><td>[[ ]]</td><td>zł netto</td></tr><tr><td>Akcyza i opłaty ustawowe</td><td>[[ ]]</td><td>zł netto</td></tr><tr><td>Razem w roku</td><td>[[ ]]</td><td>zł netto</td></tr></tbody></table><figcaption class="wp-element-caption">Przykład ilustruje strukturę kosztu, nie ofertę.</figcaption></figure>
<!-- /wp:table -->

<!-- wp:block {"ref":"__BLOCK:zastrzezenie-cen__"} /--></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"FAQ"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|70","bottom":"var:preset|spacing|70"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)"><!-- wp:heading -->
<h2 class="wp-block-heading">Pytania o cenę stałą</h2>
<!-- /wp:heading -->

<!-- wp:block {"ref":"__BLOCK:faq-produkt__"} /--></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"Źródła i aktualizacja"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|50","bottom":"var:preset|spacing|50"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)"><!-- wp:heading {"level":2,"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Źródła</h2>
<!-- /wp:heading -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Ustawa Prawo energetyczne, art. 4j (zmiana sprzedawcy) – <a href="https://isap.sejm.gov.pl">ISAP, Sejm RP</a></li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Urząd Regulacji Energetyki, taryfy operatorów systemów dystrybucyjnych – <a href="https://www.ure.gov.pl">ure.gov.pl</a></li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Towarowa Giełda Energii, indeksy rynku gazu – <a href="https://tge.pl">tge.pl</a></li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Ostatnia aktualizacja: [[data]] · Autor: [[imię i nazwisko, stanowisko]]</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"metadata":{"name":"CTA końcowe"},"templateLock":"contentOnly","align":"full","style":{"spacing":{"padding":{"top":"var:preset|spacing|80","bottom":"var:preset|spacing|80"}}},"backgroundColor":"surface","layout":{"type":"constrained"}} -->
<div class="wp-block-group alignfull has-surface-background-color has-background" style="padding-top:var(--wp--preset--spacing--80);padding-bottom:var(--wp--preset--spacing--80)"><!-- wp:block {"ref":"__BLOCK:cta-wgraj-fakture__"} /--></div>
<!-- /wp:group -->]]></content:encoded>
		<excerpt:encoded><![CDATA[]]></excerpt:encoded>
		<wp:post_id>1004</wp:post_id>
