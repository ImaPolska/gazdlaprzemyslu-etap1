	<item>
		<title><![CDATA[Slot: kalkulator wypowiedzenia]]></title>
		<link>https://gazdlaprzemyslu.pl/slot-kalkulator-wypowiedzenia/</link>
		<pubDate>Sun, 13 Sep 2026 12:00:00 +0000</pubDate>
		<dc:creator><![CDATA[redaktor]]></dc:creator>
		<guid isPermaLink="false">https://gazdlaprzemyslu.pl/?p=9005</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Slot: kalkulator wypowiedzenia"},"className":"gdp-slot","layout":{"type":"constrained"}} -->
<div class="wp-block-group gdp-slot"><!-- wp:columns {"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column {"width":"55%","className":"gdp-karta"} -->
<div class="wp-block-column gdp-karta" style="flex-basis:55%"><!-- wp:heading {"level":2,"fontSize":"m"} -->
<h2 class="wp-block-heading has-m-font-size">Dane z Twojej umowy</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"className":"gdp-etykieta-pola"} -->
<p class="gdp-etykieta-pola">Data końca umowy</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole"} -->
<p class="gdp-pole">DD.MM.RRRR</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-etykieta-pola"} -->
<p class="gdp-etykieta-pola">Okres wypowiedzenia</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole"} -->
<p class="gdp-pole">np. 3 miesiące ze skutkiem na koniec miesiąca</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-etykieta-pola"} -->
<p class="gdp-etykieta-pola">Klauzula prolongacyjna</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-pole"} -->
<p class="gdp-pole">Tak, umowa przedłuża się automatycznie o [[ ]] / Nie</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/kontakt/">Oblicz termin</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Wynik ma charakter informacyjny. Termin z umowy weryfikuje człowiek przed przygotowaniem jakiegokolwiek dokumentu.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column {"width":"45%","className":"gdp-karta","backgroundColor":"surface"} -->
<div class="wp-block-column gdp-karta has-surface-background-color has-background" style="flex-basis:45%"><!-- wp:paragraph {"className":"gdp-etykieta"} -->
<p class="gdp-etykieta">Wynik</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-liczba"} -->
<p class="gdp-liczba">[[DD.MM.RRRR]]</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>Ostatni dzień na skuteczne złożenie wypowiedzenia, żeby umowa zakończyła się w terminie i nie przedłużyła automatycznie.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"className":"gdp-tekst-pomocniczy"} -->
<p class="gdp-tekst-pomocniczy">Przypomnienie e-mail na [[ ]] dni przed terminem: [[treść zgody dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column --></div>
<!-- /wp:columns --></div>
<!-- /wp:group -->]]></content:encoded>
		<excerpt:encoded><![CDATA[]]></excerpt:encoded>
